{
  "expo": {
    "name": "MAS Player",
    "slug": "mas-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B10",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masplayer.audio",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.masplayer.audio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#080B10"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class * extends expo.modules.kotlin.modules.Module { *; }\n-keep class expo.modules.audiodsp.** { *; }\n-keep class expo.modules.audio.** { *; }\n-keep class android.media.audiofx.** { *; }\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }",
            "packagingOptions": {
              "exclude": [
                "lib/armeabi-v7a/**",
                "lib/x86/**",
                "lib/x86_64/**"
              ]
            }
          }
        }
      ]
    ],
    "web": {
      "name": "MAS Player",
      "shortName": "MAS Player",
      "description": "MAS Player - Lecteur Audio Haute-Fidélité Audiophile",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "339e3385-65b3-43c5-90f8-1ac59d9825ec"
      }
    },
    "owner": "rockdago"
  }
}
